# MySQL 8 connection string
DATABASE_URL="mysql://user:password@127.0.0.1:3306/ikadi"

# Session cookie encryption secret (iron-session). Min 32 chars.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Credentials for `npm run db:seed` (admin account bootstrap)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-kuat"


# Base URL publik untuk QR verifikasi (tanpa slash di akhir).
# WAJIB di-set di produksi — aplikasi jalan di belakang proxy, jadi tanpa ini
# QR akan menunjuk 127.0.0.1/localhost. Dev boleh dikosongkan.
PUBLIC_BASE_URL="https://ikadi.web.id"

# Nama pejabat yang tampil di blok tanda tangan KTA & halaman verifikasi
KTA_KETUA_UMUM="Ketua Umum IKADI"
KTA_SEKRETARIS_JENDERAL="Sekretaris Jenderal"

# Sandi sementara untuk reset massal (`scripts/reset-participant-passwords.ts`).
# Nilai ini dipakai bersama penanda `must_change_password`, jadi setiap anggota
# dipaksa menggantinya saat login. Isi dengan nilai yang tidak dipakai di
# tempat lain. Kalau dikosongkan, dipakai nilai cadangan di kode — jangan
# dibiarkan begitu di produksi, karena nilainya ada di repo publik.
TEMP_PASSWORD=""
