# MySQL 8 connection string
DATABASE_URL="mysql://user:password@127.0.0.1:3306/ikadi"

# Session cookie encryption secret (iron-session). Min 32 chars.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Credentials for `npm run db:seed` (admin account bootstrap)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-kuat"

# Kuota cetak KTA trial (global, dihitung dari tabel kta_prints)
KTA_PRINT_LIMIT=10

# Base URL publik untuk QR verifikasi. Wajib di-set di produksi, kalau tidak
# QR menunjuk ke host request (mis. localhost saat dev).
PUBLIC_BASE_URL="http://localhost:3000"

# Nama pejabat yang tampil di blok tanda tangan KTA & halaman verifikasi
KTA_KETUA_UMUM="Ketua Umum IKADI"
KTA_SEKRETARIS_JENDERAL="Sekretaris Jenderal"
