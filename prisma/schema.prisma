generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"

}

enum OriginType {
  PW
  PD
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum SermonExperience {
  SERING
  KADANG_KADANG
  BELUM_PERNAH
  LAINNYA
}

enum QuranReading {
  TAJWID_BAIK
  BIASA
  TIDAK_LANCAR
}

enum MaritalStatus {
  BELUM_MENIKAH
  SUDAH_MENIKAH
  CERAI_HIDUP
  CERAI_MATI
}

enum BloodType {
  A
  B
  AB
  O
  TIDAK_TAHU
}

/// Status keanggotaan terpisah dari kode level: level 7 (purnabakti) tetap
/// butuh penanda status yang bisa berubah tanpa mengubah nomor anggota.
enum MembershipStatus {
  AKTIF
  NONAKTIF
  PURNABAKTI
}

model Participant {
  id                      BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  originType              OriginType       @map("origin_type")
  originName              String           @map("origin_name") @db.VarChar(150)
  fullName                String           @map("full_name") @db.VarChar(200)
  nik                     String           @unique(map: "uq_participants_nik") @db.VarChar(16)
  birthPlace              String           @map("birth_place") @db.VarChar(120)
  birthDate               DateTime         @map("birth_date") @db.Date
  gender                  Gender?          @map("gender")
  maritalStatus           MaritalStatus?   @map("marital_status")
  bloodType               BloodType?       @map("blood_type")
  address                 String           @db.Text
  addressKtp              String?          @map("address_ktp") @db.Text
  addressCurrent          String?          @map("address_current") @db.Text
  addressSameAsKtp        Boolean          @default(false) @map("address_same_as_ktp")
  province                String?          @db.VarChar(100)
  city                    String?          @db.VarChar(100)
  whatsapp                String           @db.VarChar(20)
  lastEducation           String?          @map("last_education") @db.VarChar(100)
  studyField              String?          @map("study_field") @db.VarChar(150)
  occupation              String           @db.VarChar(150)
  expertise               String?          @db.Text
  sermonExperience        SermonExperience @map("sermon_experience")
  sermonExperienceOther   String?          @map("sermon_experience_other") @db.VarChar(200)
  organizationExperience  String?          @map("organization_experience") @db.Text
  quranReading            QuranReading     @map("quran_reading")
  trainingReason          String           @map("training_reason") @db.Text
  trainingExpectation     String           @map("training_expectation") @db.Text
  photoPath               String?          @map("photo_path") @db.VarChar(255)
  ktpPath                 String?          @map("ktp_path") @db.VarChar(255)
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at")

  /// Hash argon2id sandi login anggota. NULL = belum set (peserta lama).
  passwordHash            String?          @map("password_hash") @db.VarChar(255)
  /// Kode level kepengurusan 1..7. 6 = Anggota (default pendaftar).
  levelCode               Int              @default(6) @map("level_code") @db.TinyInt
  /// Kode wilayah (provinsi) 2 digit, merujuk Province.code.
  provinceCode            String?          @map("province_code") @db.Char(2)
  /// Kode daerah (kabupaten/kota) 2 digit, unik per provinsi.
  regencyCode             String?          @map("regency_code") @db.Char(2)
  /// Nomor anggota 15 digit bertitik: L.WW.DD.YY.NNNN. Terbit saat KTA dicetak.
  memberNumber            String?          @unique(map: "uq_participants_member_number") @map("member_number") @db.VarChar(20)
  memberNumberIssuedAt    DateTime?        @map("member_number_issued_at")
  membershipStatus        MembershipStatus @default(AKTIF) @map("membership_status")

  @@index([createdAt], map: "idx_participants_created_at")
  @@index([originType, originName], map: "idx_participants_origin")
  @@index([fullName], map: "idx_participants_full_name")
  @@index([provinceCode, regencyCode], map: "idx_participants_region")
  @@map("participants")
}

model Admin {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

/// Master provinsi. `code` = kode Kemendagri 2 digit, sekaligus segmen WW.
model Province {
  code      String    @id @db.Char(2)
  name      String    @db.VarChar(100)
  regencies Regency[]

  @@map("provinces")
}

/// Master kabupaten/kota. `code` 2 digit unik per provinsi (segmen DD).
model Regency {
  provinceCode String   @map("province_code") @db.Char(2)
  code         String   @db.Char(2)
  name         String   @db.VarChar(120)
  province     Province @relation(fields: [provinceCode], references: [code], onDelete: Cascade)

  @@id([provinceCode, code])
  @@index([provinceCode], map: "idx_regencies_province")
  @@map("regencies")
}

/// Penghitung seri nomor anggota. Unik per (level, wilayah, daerah, tahun),
/// supaya NNNN berurutan tanpa bentrok saat dua admin mencetak bersamaan.
model MemberNumberSequence {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  levelCode    Int    @map("level_code") @db.TinyInt
  provinceCode String @map("province_code") @db.Char(2)
  regencyCode  String @map("regency_code") @db.Char(2)
  year         Int    @db.SmallInt
  lastSerial   Int    @default(0) @map("last_serial") @db.UnsignedSmallInt

  @@unique([levelCode, provinceCode, regencyCode, year], map: "uq_member_number_sequence")
  @@map("member_number_sequences")
}

/// Riwayat cetak KTA. Sekaligus sumber kuota cetak global (trial: 10).
model KtaPrint {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  participantId    BigInt   @map("participant_id") @db.UnsignedBigInt
  memberNumber     String   @map("member_number") @db.VarChar(20)
  printedByAdminId BigInt   @map("printed_by_admin_id") @db.UnsignedBigInt
  printedAt        DateTime @default(now()) @map("printed_at")

  @@index([printedAt], map: "idx_kta_prints_printed_at")
  @@index([participantId], map: "idx_kta_prints_participant")
  @@map("kta_prints")
}

/// Nama pejabat penanda tangan KTA. Diedit admin lewat /admin/kta/pejabat.
/// `key` = kunci tetap ("ketuaUmum" / "sekjen") supaya kartu & halaman
/// verifikasi membaca baris yang sama.
model KtaOfficial {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key       String   @unique @db.VarChar(20)
  nama      String   @db.VarChar(200)
  jabatan   String   @db.VarChar(120)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kta_officials")
}
