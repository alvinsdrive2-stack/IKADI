generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"

}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum MaritalStatus {
  BELUM_MENIKAH
  SUDAH_MENIKAH
  CERAI_HIDUP
  CERAI_MATI
}

enum BloodType {
  A
  B
  AB
  O
  TIDAK_TAHU
}

/// Status keanggotaan terpisah dari kode level: level 7 (purnabakti) tetap
/// butuh penanda status yang bisa berubah tanpa mengubah nomor anggota.
enum MembershipStatus {
  AKTIF
  NONAKTIF
  PURNABAKTI
}

/// Riwayat kartu/nomor anggota. Satu peserta boleh punya banyak kartu, tapi
/// hanya satu yang aktif, QR tiap kartu menuju halaman verifikasi yang
/// menampilkan kartu aktif, dan nomor lama tetap dikenali sebagai milik orang
/// yang sama.
///
/// `participants.member_number` adalah cermin kartu aktif (ditulis hanya oleh
/// `lib/member-cards.ts`) supaya pencarian admin dan halaman lama tidak perlu
/// join. Jangan menulis kolom itu dari tempat lain.
model MemberCard {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  participantId BigInt   @map("participant_id") @db.UnsignedBigInt
  memberNumber  String   @unique(map: "uq_member_cards_number") @map("member_number") @db.VarChar(20)
  /// Level dan wilayah saat nomor ini terbit, snapshot riwayat, bukan acuan akses.
  levelCode     Int      @map("level_code") @db.TinyInt
  provinceCode  String   @map("province_code") @db.Char(2)
  regencyCode   String   @map("regency_code") @db.Char(2)
  issuedAt      DateTime @default(now()) @map("issued_at")
  /// Terbit manual oleh admin (nomor cantik / nomor lama yang dipulihkan).
  isManual      Boolean  @default(false) @map("is_manual")
  isActive      Boolean  @default(false) @map("is_active")
  /// Diisi saat kartu digantikan kartu lain.
  retiredAt     DateTime? @map("retired_at")

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, isActive], map: "idx_member_cards_participant")
  @@map("member_cards")
}

model Participant {
  id                      BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  fullName                String           @map("full_name") @db.VarChar(200)
  nik                     String           @unique(map: "uq_participants_nik") @db.VarChar(16)
  birthPlace              String           @map("birth_place") @db.VarChar(120)
  birthDate               DateTime         @map("birth_date") @db.Date
  gender                  Gender?          @map("gender")
  maritalStatus           MaritalStatus?   @map("marital_status")
  bloodType               BloodType?       @map("blood_type")
  address                 String           @db.Text
  addressKtp              String?          @map("address_ktp") @db.Text
  addressCurrent          String?          @map("address_current") @db.Text
  addressSameAsKtp        Boolean          @default(false) @map("address_same_as_ktp")
  province                String?          @db.VarChar(100)
  city                    String?          @db.VarChar(100)
  whatsapp                String           @db.VarChar(20)
  lastEducation           String?          @map("last_education") @db.VarChar(100)
  studyField              String?          @map("study_field") @db.VarChar(150)
  occupation              String           @db.VarChar(150)
  expertise               String?          @db.Text
  photoPath               String?          @map("photo_path") @db.VarChar(255)
  ktpPath                 String?          @map("ktp_path") @db.VarChar(255)
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at")

  /// Hash argon2id sandi login anggota. NULL = belum set (peserta lama).
  passwordHash            String?          @map("password_hash") @db.VarChar(255)
  /// Peran pengurus. Terpisah dari levelCode: level cuma jenis kepengurusan,
  /// isPengurus yang memberi akses menu pengurus. Level pengurus = 1..3.
  isPengurus              Boolean          @default(false) @map("is_pengurus")
  /// Kode level kepengurusan 1..7. 6 = Anggota (default pendaftar).
  levelCode               Int              @default(6) @map("level_code") @db.TinyInt
  /// Kode wilayah (provinsi) 2 digit, merujuk Province.code.
  provinceCode            String?          @map("province_code") @db.Char(2)
  /// Kode daerah (kabupaten/kota) 2 digit, unik per provinsi.
  regencyCode             String?          @map("regency_code") @db.Char(2)
  /// Nomor anggota 15 digit bertitik: L.WW.DD.YY.NNNN. Terbit saat KTA dicetak.
  memberNumber            String?          @unique(map: "uq_participants_member_number") @map("member_number") @db.VarChar(20)
  memberNumberIssuedAt    DateTime?        @map("member_number_issued_at")
  membershipStatus        MembershipStatus @default(AKTIF) @map("membership_status")

  /// Import dari sistem lain tanpa data lengkap (mis. MUNAS): true berarti
  /// anggota wajib melengkapi profil dan membuat sandi baru sebelum memakai
  /// layanan. Kolom wajib lain diisi string kosong, bukan data karangan.
  needsProfileCompletion Boolean          @default(false) @map("needs_profile_completion")

  /// Asal data peserta. NULL = mendaftar sendiri lewat formulir IKADI.
  /// Relasi ini yang menjawab "data ini dari mana", bukan kolom teks bebas.
  sourceId                Int?             @map("source_id")
  source                  DataSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  /// Riwayat kartu. Kolom `memberNumber` di atas = cermin kartu yang isActive.
  memberCards             MemberCard[]

  @@index([createdAt], map: "idx_participants_created_at")
  @@index([fullName], map: "idx_participants_full_name")
  @@index([provinceCode, regencyCode], map: "idx_participants_region")
  @@index([isPengurus, levelCode], map: "idx_participants_pengurus")
  @@index([sourceId], map: "idx_participants_source")
  @@map("participants")
}

/// Sumber data peserta, mis. impor dari pendataan MUNAS IV.
///
/// Tabel terpisah, bukan kolom enum, supaya penambahan sumber baru tidak perlu
/// migrasi skema dan supaya asal-usul bisa dicatat lengkap: kapan diimpor,
/// oleh siapa, dari sistem mana, dan berapa baris masuk/dilewati.
model DataSource {
  id          Int      @id @default(autoincrement())
  /// Kunci stabil untuk kode: "munas-iv-2026", "mandiri", dst.
  key         String   @unique @db.VarChar(50)
  label       String   @db.VarChar(120)
  /// Sistem asal, mis. nama database atau aplikasi sumber.
  origin      String?  @db.VarChar(120)
  importedAt  DateTime @default(now()) @map("imported_at")
  /// Catatan hasil impor (mis. jumlah baris masuk dan dilewati), teks bebas.
  note        String?  @db.Text

  participants Participant[]

  @@map("data_sources")
}

model Admin {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

/// Master provinsi. `code` = kode Kemendagri 2 digit, sekaligus segmen WW.
model Province {
  code      String    @id @db.Char(2)
  name      String    @db.VarChar(100)
  regencies Regency[]

  @@map("provinces")
}

/// Master kabupaten/kota. `code` 2 digit unik per provinsi (segmen DD).
model Regency {
  provinceCode String   @map("province_code") @db.Char(2)
  code         String   @db.Char(2)
  name         String   @db.VarChar(120)
  province     Province @relation(fields: [provinceCode], references: [code], onDelete: Cascade)

  @@id([provinceCode, code])
  @@index([provinceCode], map: "idx_regencies_province")
  @@map("regencies")
}

/// Penghitung seri nomor anggota. Unik per (level, wilayah, daerah, tahun),
/// supaya NNNN berurutan tanpa bentrok saat dua admin mencetak bersamaan.
model MemberNumberSequence {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  levelCode    Int    @map("level_code") @db.TinyInt
  provinceCode String @map("province_code") @db.Char(2)
  regencyCode  String @map("regency_code") @db.Char(2)
  year         Int    @db.SmallInt
  lastSerial   Int    @default(0) @map("last_serial") @db.UnsignedSmallInt

  @@unique([levelCode, provinceCode, regencyCode, year], map: "uq_member_number_sequence")
  @@map("member_number_sequences")
}

/// Riwayat cetak KTA. Sekaligus sumber kuota cetak global (trial: 10).
model KtaPrint {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  participantId    BigInt   @map("participant_id") @db.UnsignedBigInt
  memberNumber     String   @map("member_number") @db.VarChar(20)
  /// Pemegang nomor dicetak oleh admin (area /admin) atau oleh pengurus (area /anggota).
  printedByAdminId BigInt?  @map("printed_by_admin_id") @db.UnsignedBigInt
  printedByParticipantId BigInt? @map("printed_by_participant_id") @db.UnsignedBigInt
  printedAt        DateTime @default(now()) @map("printed_at")

  @@index([printedAt], map: "idx_kta_prints_printed_at")
  @@index([participantId], map: "idx_kta_prints_participant")
  @@map("kta_prints")
}

/// Nama pejabat penanda tangan KTA. Diedit admin lewat /admin/kta/pejabat.
/// `key` = kunci tetap ("ketuaUmum" / "sekjen") supaya kartu & halaman
/// verifikasi membaca baris yang sama.
model KtaOfficial {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key       String   @unique @db.VarChar(20)
  nama      String   @db.VarChar(200)
  jabatan   String   @db.VarChar(120)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kta_officials")
}
